+mod partition_tests {
+    use super::*;
+    #[test]
+    fn partition_boundaries_and_independent_readers() -> io::Result<()> {
+        let root = std::env::temp_dir().join(format!("retoc-partitions-{}-{}", std::process::id(), std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+        fs::create_dir(&root)?;
+        fs::write(root.join("test.ucas"), b"ABCD")?;
+        fs::write(root.join("test_s1.ucas"), b"EF")?;
+        {
+            let mut a = PartitionedFile::open(root.join("test.ucas"), 2, 4)?;
+            let mut b = a.reader();
+            a.seek(SeekFrom::Start(2))?;
+            let mut across = [0; 4];a.read_exact(&mut across)?;assert_eq!(&across, b"CDEF");
+            let mut first = [0; 2];b.read_exact(&mut first)?;assert_eq!(&first, b"AB");
+            a.seek(SeekFrom::End(-1))?;let mut last = [0];a.read_exact(&mut last)?;assert_eq!(&last, b"F");
+            assert!(a.seek(SeekFrom::Current(-7)).is_err());
+            assert!(PartitionedFile::open(root.join("test.ucas"), 3, 4).is_err());
+        }
+        fs::remove_dir_all(root)?;Ok(())
+    }
+}
