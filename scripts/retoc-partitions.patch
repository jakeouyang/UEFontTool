+use std::io::{self, Read, Seek, SeekFrom};
+
+/// Read UCAS partitions in their virtual address space without merging or copying them.
+pub struct PartitionedFile {
+    files: Vec<FilePool>,
+    partition_size: u64,
+    length: u64,
+    position: u64,
+}
+
+impl PartitionedFile {
+    pub fn open(path: PathBuf, count: u32, partition_size: u64) -> io::Result<Self> {
+        if count == 0 || count > 1024 || partition_size == 0 {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid UCAS partition layout"));
+        }
+        let stem = path.file_stem().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "UCAS filename missing"))?;
+        let mut files = Vec::new();
+        let mut last_length = 0;
+        for index in 0..count {
+            let part = if index == 0 { path.clone() } else {
+                let mut name = stem.to_os_string();
+                name.push(format!("_s{index}.ucas"));
+                path.with_file_name(name)
+            };
+            last_length = fs::metadata(&part)?.len();
+            if last_length > partition_size {
+                return Err(io::Error::new(io::ErrorKind::InvalidData, "UCAS partition exceeds declared stride"));
+            }
+            files.push(FilePool::new(part, rayon::max_num_threads())?);
+        }
+        let length = u64::from(count - 1).checked_mul(partition_size).and_then(|n| n.checked_add(last_length))
+            .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "UCAS address space overflow"))?;
+        Ok(Self { files, partition_size, length, position: 0 })
+    }
+
+    pub fn reader(&self) -> Self {
+        Self { files: self.files.clone(), partition_size: self.partition_size, length: self.length, position: 0 }
+    }
+}
+
+impl Read for PartitionedFile {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        if buffer.is_empty() || self.position >= self.length { return Ok(0); }
+        let index = (self.position / self.partition_size) as usize;
+        let offset = self.position % self.partition_size;
+        let size = (buffer.len() as u64).min(self.partition_size - offset) as usize;
+        let mut handle = self.files[index].acquire()?;
+        handle.file().seek(SeekFrom::Start(offset))?;
+        let read = handle.file().read(&mut buffer[..size])?;
+        self.position += read as u64;
+        Ok(read)
+    }
+}
+
+impl Seek for PartitionedFile {
+    fn seek(&mut self, from: SeekFrom) -> io::Result<u64> {
+        let target = match from {
+            SeekFrom::Start(n) => i128::from(n),
+            SeekFrom::Current(n) => i128::from(self.position) + i128::from(n),
+            SeekFrom::End(n) => i128::from(self.length) + i128::from(n),
+        };
+        self.position = u64::try_from(target).map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "invalid UCAS seek"))?;
+        Ok(self.position)
+    }
+}
 
